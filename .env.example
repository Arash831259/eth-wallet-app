# Optional: a custom Sepolia JSON-RPC endpoint (Alchemy, Infura, QuickNode, ...).
# If left empty, the app uses the default public Sepolia RPC bundled with viem,
# which can be slow or rate-limited.
#
# NOTE: Vite inlines VITE_* variables into the public JS bundle, so anything you
# put here is visible to users. Use a key restricted to your domain, never a secret.
#
# Copy this file to `.env` (git-ignored) to use it locally.
VITE_SEPOLIA_RPC_URL=
